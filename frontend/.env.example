# Frontend backend origin. Both are OPTIONAL - when unset, the app uses the
# page's own origin (HTTP) and derives the WS URL from it (ws/wss + host).
# Set these only for the dev server (:3000 -> :8000) or split-origin deploys.
# NOTE: a cross-origin value also requires the backend CORS allowlist
# (backend/main.py) to include this frontend origin - :3000 is already allowed.
VITE_API_BASE=
VITE_WS_URL=
